#   cp .env.example .env
# .env 는 절대 커밋하지 않음. (.gitignore 에 포함됨).

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
# 사용할 모델
OPENAI_MODEL=gpt-4o-mini
# 요청 타임아웃(초)
OPENAI_TIMEOUT=60

# ── App ───────────────────────────────────────────────────
# dev / prod
APP_ENV=dev
# 프론트엔드(Vite) 주소. CORS 허용 목록.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── DB ────────────────────────────────────────────────────
# 개발: SQLite(async). 운영: postgresql+asyncpg://user:pw@host:5432/nudgely
DATABASE_URL=sqlite+aiosqlite:///./nudgely.db
# True 면 실행되는 SQL 을 콘솔에 출력(디버깅용)
DB_ECHO=false
# 앱 시작 시 테이블 자동 생성(개발 편의). 운영은 false + `alembic upgrade head`.
AUTO_CREATE_TABLES=true

# ── 인증(JWT) ─────────────────────────────────────────────
# ⚠️ 운영에서는 반드시 강력한 무작위 값으로 교체할 것.
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
# 액세스 토큰 만료(분). 기본 7일.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
