#   cp .env.example .env
# .env 는 절대 커밋하지 않음. (.gitignore 에 포함됨).

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
# 사용할 모델
# 채팅 한 턴(도구 판단 + 답변). 사용자가 기다리는 쪽이라 좋은 모델을 쓴다
OPENAI_CHAT_MODEL=gpt-4.1
# 배치(밤 11시 독촉 문구 등). 아무도 안 보는 쪽이라 싼 모델로 충분하다
OPENAI_BATCH_MODEL=gpt-4o-mini
# 요청 타임아웃(초)
OPENAI_TIMEOUT=60

# ── App ───────────────────────────────────────────────────
# dev / prod
APP_ENV=dev
# CORS 허용 목록. 개발은 Vite 주소.
# ⚠️ 앱(Capacitor)의 출처는 사이트 주소가 아니라 웹뷰가 만든 로컬 출처다.
#    배포에서 빠뜨리면 앱의 모든 요청이 막힌다(docs/deploy.md §6):
#    capacitor://localhost,https://localhost,http://localhost
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── DB ────────────────────────────────────────────────────
# 개발: SQLite(async). 운영: Postgres.
# 호스팅이 준 postgresql:// 주소를 그대로 넣어도 된다(asyncpg 용으로 고쳐 쓴다).
DATABASE_URL=sqlite+aiosqlite:///./nudgely.db
# True 면 실행되는 SQL 을 콘솔에 출력(디버깅용)
DB_ECHO=false
# 앱 시작 시 테이블 자동 생성(개발 편의). 운영은 false + `alembic upgrade head`.
AUTO_CREATE_TABLES=true

# ── 약관 ──────────────────────────────────────────────────
# 회원이 어느 버전 약관에 동의했는지 기록하는 값(docs/terms-of-service.md 부칙의 시행일).
# 약관을 개정하면 이 값을 새 시행일로 바꾸고, 값이 다른 회원에게 재동의를 받는다.
TERMS_VERSION=2026-09-29

# ── 인증(JWT) ─────────────────────────────────────────────
# ⚠️ 운영에서는 반드시 강력한 무작위 값으로 교체할 것.
# APP_ENV 가 dev 가 아니면 이 값 그대로는 서버가 뜨지 않는다.
# 운영 키 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
# 액세스 토큰 만료(분). 기본 7일.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── 푸시(FCM HTTP v1) ─────────────────────────────────────
# 앱이 꺼져 있을 때 알릴 유일한 수단. 아래 두 값이 없으면 발송을 조용히 건너뛴다
# (개발·테스트는 설정 없이 그대로 돌아간다). /api/health 의 pushConfigured 로 확인.
PUSH_ENABLED=true

# 서비스 계정 키. Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 에서 받는다.
# 둘 중 하나만 있으면 된다. ⚠️ 어느 쪽이든 저장소에 커밋하지 말 것 —
# 이 키 하나로 누구에게든 푸시를 보낼 수 있다.
#
# 로컬: 받은 파일을 그대로 두고 경로만 가리킨다
FCM_CREDENTIALS_FILE=/path/to/nudgely-firebase-adminsdk-xxxxx.json
# 배포: 호스팅에 파일을 올릴 자리가 없어 JSON 을 통째로 넣는다(한 줄, 따옴표 없이).
# 값에 줄바꿈(\n)이 들어 있으니 그대로 붙여넣을 것. 둘 다 있으면 이쪽이 이긴다.
FCM_CREDENTIALS_JSON=

# 비워 두면 위 키의 project_id 를 쓴다. 굳이 두 군데 적어 어긋나게 둘 이유가 없다
FCM_PROJECT_ID=
