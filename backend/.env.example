#   cp .env.example .env
# .env 는 절대 커밋하지 않음. (.gitignore 에 포함됨).

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
# 사용할 모델 
OPENAI_MODEL=gpt-4o-mini
# 요청 타임아웃(초)
OPENAI_TIMEOUT=60

# ── App ───────────────────────────────────────────────────
# dev / prod
APP_ENV=dev
# 프론트엔드(Vite) 주소. CORS 허용 목록.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
