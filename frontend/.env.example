# 백엔드 API 베이스 URL. 개발에서는 '/api' 로 두고 vite 프록시가 넘긴다.
#
# ⚠️ 앱(Capacitor) 빌드에는 프록시가 없다. '/api' 는 앱 내부를 가리켜 아무 데도
# 닿지 않으므로 .env.production 에 절대 주소를 넣어야 한다(docs/mobile.md §2).
#   시뮬레이터: http://localhost:8000/api
#   실기기:     https://<배포된 백엔드>/api   ← 평문 http 는 iOS·Android 가 막는다
VITE_API_BASE_URL=/api

# 소셜 로그인 (없으면 버튼을 눌러도 '준비 중' 안내만 나온다)
VITE_KAKAO_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# 콜백 주소. 비우면 현재 도메인 + /auth/callback 을 쓴다
VITE_OAUTH_REDIRECT_URI=
